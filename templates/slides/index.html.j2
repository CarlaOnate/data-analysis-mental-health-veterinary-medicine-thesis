{#- nbconvert's reveal template, with a scroll fix: its "reveal_scroll" option sets tall slides to
    95vh + 20px margin inside a scaled 960x700 frame, so the bottom of long slides is cut off.
    Here slides fill the window at scale 1 and every slide is a scroll box exactly the window's height. -#}
{%- extends 'reveal/index.html.j2' -%}

{%- block html_head_css -%}
<style>
  /* Each slide fills the window; the inner section (the actual slide) is the scroll box */
  .reveal .slides > section {
    height: 100% !important;
    top: 0 !important;
    padding: 0;
  }
  .reveal .slides > section > section {
    height: 100% !important;
    top: 0 !important;
    overflow-y: auto;
    box-sizing: border-box;
    padding: 24px 40px 56px; /* bottom room for the controls and slide number */
  }
</style>
{%- endblock html_head_css -%}

{% block footer_js %}
<script>
require(
    {
      // it makes sense to wait a little bit when you are loading
      // reveal from a cdn in a slow connection environment
      waitSeconds: 15
    },
    [
      "{{ reveal_url_prefix }}/dist/reveal.js",
      "{{ reveal_url_prefix }}/plugin/notes/notes.js"
    ],

    function(Reveal, RevealNotes){
        Reveal.initialize({
            controls: true,
            progress: true,
            history: true,
            transition: "{{reveal_transition}}",
            slideNumber: "{{reveal_number}}",
            plugins: [RevealNotes],
            // Fill the window without scaling, so the slide is exactly as tall as the screen
            width: "100%",
            height: "100%",
            margin: 0,
            minScale: 1,
            maxScale: 1,
            center: false,
        });

        var update = function(event){
          if(MathJax.Hub.getAllJax(Reveal.getCurrentSlide())){
            MathJax.Hub.Rerender(Reveal.getCurrentSlide());
          }
        };

        Reveal.addEventListener('slidechanged', update);
    }
);
</script>
{% endblock footer_js %}
